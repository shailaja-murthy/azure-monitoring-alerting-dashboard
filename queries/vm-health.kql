
//
// 1. Linux system log monitoring
//
Syslog
| where TimeGenerated > ago(24h)
| project TimeGenerated,
          Computer,
          HostName,
          ProcessName,
          SeverityLevel,
          SyslogMessage
| order by TimeGenerated desc

//
// 2. Virtual machine heartbeat monitoring
//
Heartbeat
| where TimeGenerated > ago(1h)
| summarize LastHeartbeat = max(TimeGenerated) by Computer
| extend Status = iff(
    LastHeartbeat > ago(5m),
    "Healthy",
    "No recent heartbeat"
)
| project Computer, LastHeartbeat, Status
